@page "/orders"

@using ECommerceOrders.Client.Models
@using ECommerceOrders.Client.Pages.Dialogs
@using ECommerceOrders.Client.Services

@inject OrderService OrderService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">
    Orders
</MudText>

<MudStack Row="true"
          AlignItems="AlignItems.Center"
          Justify="Justify.FlexStart"
          Spacing="2"
          Class="mb-4">

    <MudIconButton Icon="@Icons.Material.Filled.Add"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   title="Dodaj zamówienie"
                   OnClick="AddOrder"/>

    <MudTextField @bind-Value="searchPhase"
                  Label="Szukaj"
                  Variant="Variant.Outlined"
                  Style="max-width: 400px; flex: none" />

    <MudIconButton Icon="@Icons.Material.Filled.Search"
                   Color="Color.Primary"
                   Size="Size.Medium"
                   title="Wyszukaj zamówienie"
                   OnClick="OnSearchInput" />

</MudStack>

@if (result is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="@orders"
              Hover="true"
              Striped="true"
              Bordered="true"
              Dense="true">

        <HeaderContent>
            <MudTh>Numer zamówienia</MudTh>
            <MudTh>Data zamówienia</MudTh>
            <MudTh>Zamówione produkty</MudTh>
            <MudTh>Łączna kwota</MudTh>
            <MudTh>Status zamówienia</MudTh>
            <MudTh>Akcje</MudTh>
        </HeaderContent>

        <RowTemplate>

            <MudTd DataLabel="Numer zamówienia">
                #@context.Id
            </MudTd>

            <MudTd DataLabel="Data zamówienia">
                @context.CreatedAt.ToString("dd.MM.yyyy HH:mm")
            </MudTd>

            <MudTd DataLabel="Zamówione produkty">
                @foreach (var orderProduct in context.OrderProducts)
                {
                    <div>
                        @orderProduct.ProductName × @orderProduct.Quantity
                    </div>
                }
            </MudTd>

            <MudTd DataLabel="Łączna kwota">
                @context.TotalAmount.ToString("0.00") zł
            </MudTd>

            <MudTd DataLabel="Status zamówienia">
                @switch (context.Status)
                {
                    case "Zakończone":
                        <MudChip T="string"
                                 Color="Color.Success"
                                 Size="Size.Small">
                            Zakończone
                        </MudChip>
                        break;
                    case "Anulowane":
                        <MudChip T="string"
                                Color="Color.Error"
                                Size="Size.Small">
                                Anulowane
                        </MudChip>
                        break;
                    case "New":
                        <MudChip T="string"
                            Color="Color.Transparent"
                            Size="Size.Small">
                            Nowe
                        </MudChip>
                        break;
                    default:
                        <MudChip T="string"
                                 Color="Color.Warning"
                                 Size="Size.Small">
                            @context.Status
                        </MudChip>
                        break;
				}
            </MudTd>

            <MudTd DataLabel="Akcje"
                   Style="width: 1%; white-space: nowrap;">

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Class="pa-1"
                               title="Edytuj"
                               OnClick="@(() => EditOrder(context))"/>

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               Size="Size.Small"
                               Class="pa-1"
                               title="Usuń" 
                               OnClick="@(() => DleteOrder(context.Id))"
                               />

            </MudTd>

        </RowTemplate>

    </MudTable>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-4 flex-wrap" Spacing="2">

    <MudText Typo="Typo.body2">
        @if (totalItems == 0)
        {
            <span>Brak wyników</span>
        }
        else
        {
            var from = (currentPage - 1) * pageSize + 1;
            var to = Math.Min(currentPage * pageSize, totalItems);
            <span>@from–@to z @totalItems</span>
        }
    </MudText>

    <MudPagination Count="@TotalPages"
                   Selected="@currentPage"
                   SelectedChanged="OnPageChanged"
                   ShowFirstButton="true"
                   ShowLastButton="true"
                   BoundaryCount="1"
                   MiddleCount="3"
                   Color="Color.Primary" />

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Typo="Typo.body2">Wierszy na stronie:</MudText>
        <MudSelect T="int"
                   Value="@pageSize"
                   ValueChanged="OnPageSizeChanged"
                   Variant="Variant.Outlined"
                   Dense="true"
                   Style="width: 90px;">
            @foreach (var option in pageSizeOptions)
            {
                <MudSelectItem T="int" Value="@option">@option</MudSelectItem>
            }
        </MudSelect>
    </MudStack>

</MudStack>
@code {
	private void OnSearchInput()
	{
		throw new NotImplementedException();
	}
}