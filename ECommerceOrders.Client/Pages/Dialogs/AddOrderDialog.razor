@using ECommerceOrders.Client.Models
@using ECommerceOrders.Client.Services
@inject ProductService ProductService

<MudDialog>

    <DialogContent>

        <MudText Typo="Typo.h6" Class="mb-4">
            Wybierz produkty
        </MudText>

        @if (products == null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            @foreach (var product in selectedProducts)
            {
                <MudPaper Class="pa-3 mb-2">

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Justify="Justify.SpaceBetween">

                        <div>
                            <MudText>
                                @product.ProductName
                            </MudText>

                            <MudText Typo="Typo.caption">
                                @product.Price.ToString("0.00") zł
                            </MudText>
                        </div>

                        <MudNumericField T="int"
                                         @bind-Value="product.Quantity"
                                         Min="1"
                                         Label="Ilość"
                                         Style="max-width: 120px;" />

                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle"
                                       Color="Color.Error"
                                       Size="Size.Small" 
                                       OnClick="@(() => RemoveProduct(product.ProductId))"
                                       title="Usuń"/>

                    </MudStack>

                </MudPaper>
            }

            <MudSelect T="int"
                       Label="Dodaj produkt"
                       Variant="Variant.Outlined"
                       ValueChanged="AddProduct">

                @foreach (var product in products)
                {
                    <MudSelectItem Value="@product.Id">
                        @product.Name
                    </MudSelectItem>
                }

            </MudSelect>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6">
                Suma: @Total.ToString("0.00") zł
            </MudText>
        }

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel">
            Anuluj
        </MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(selectedProducts.Count == 0)"
                   OnClick="Save">

            Utwórz zamówienie

        </MudButton>

    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private List<Product>? products;

    private List<SelectedOrderProduct> selectedProducts = [];

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetProductsAsync();
    }

    private void AddProduct(int productId)
    {
        var product = products?
            .FirstOrDefault(p => p.Id == productId);

        if (product == null)
            return;

        if (selectedProducts.Any(p => p.ProductId == productId))
            return;

        selectedProducts.Add(new SelectedOrderProduct
        {
            ProductId = product.Id,
            ProductName = product.Name,
            Price = product.Price,
            Quantity = 1
        });
    }

    private decimal Total =>
        selectedProducts.Sum(p => p.Price * p.Quantity);

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void Save()
    {
        var order = new CreateOrder
        {
            Products = selectedProducts
                .Select(p => new CreateOrderItem
                {
                    ProductId = p.ProductId,
                    Quantity = p.Quantity
                })
                .ToList()
        };

        MudDialog.Close(DialogResult.Ok(order));
    }

    private void RemoveProduct(int productId)
    {
        var product = selectedProducts.FirstOrDefault(p => p.ProductId == productId);

        if (product != null)
        {
            selectedProducts.Remove(product);
        }
    }
}