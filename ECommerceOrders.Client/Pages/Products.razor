@page "/products"
@using ECommerceOrders.Client.Models
@using ECommerceOrders.Client.Pages.Dialogs
@using ECommerceOrders.Client.Services
@inject ProductService ProductService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" Class="mb-4">
    Products
</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center"
          Justify="Justify.FlexStart"
          Spacing="2"
          Class="mb-4" >

<MudIconButton Icon="@Icons.Material.Filled.Add"
    Color="Color.Primary"
    Size="Size.Medium"
	title="Dodaj produkt" 
    OnClick="AddProduct"/>

<MudTextField @bind-Value="searchPhase"
              @bind-Value:after="OnSearchInput"
              Label="Szukaj"
              Variant="Variant.Outlined"
              Class="flex-grow-0"
              Style="max-width: 400px; flex: none" />

<MudIconButton Icon="@Icons.Material.Filled.Search"
            Color="Color.Primary"
            Size="Size.Medium"
            title="Wyszukaj produkt"
                   OnClick="OnSearchInput" />


</MudStack>

<MudTable Items="@products" Hover="true" Striped="true" Bordered="true" Dense="true">

    <HeaderContent>
        <MudTh>Nazwa</MudTh>
        <MudTh>Opis</MudTh>
        <MudTh>Cena</MudTh>
        <MudTh>Stan</MudTh>
        <MudTh>Akcje</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Name</MudTd>
        <MudTd>@context.Description</MudTd>
        <MudTd>@context.Price zł</MudTd>
        <MudTd>@context.StockQuantity</MudTd>
        <MudTd Style="width: 1%; white-space: nowrap;">
            <MudIconButton Icon="@Icons.Material.Filled.Edit"
            Color="Color.Primary"
            Size="Size.Small"
            Class="pa-1"
            title="Edytuj" 
            OnClick="@(() => EditProduct(context))" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete"
            Color="Color.Error"
            Size="Size.Small"
            Class="pa-1"
			title="Usuń"
            OnClick="@(() => DeleteProduct(context.Id))" />
        </MudTd>
    </RowTemplate>

</MudTable>

<MudButton>
    1
</MudButton>